# Copiar como .env y ajustar valores reales. Nunca subir el .env real al repositorio.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/db_regresape
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

MAX_IMPORT_FILE_SIZE_MB=10
MAX_IMPORT_ROWS=50000

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

ENV=development

# Proveedores externos opcionales (dejar vacío para usar MockProvider, sección 91 del brief).
OPENAI_API_KEY=
EMAIL_API_KEY=
WHATSAPP_API_KEY=
